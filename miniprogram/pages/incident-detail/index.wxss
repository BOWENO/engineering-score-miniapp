.hero{padding:30rpx;color:#fff;border-radius:28rpx;background:linear-gradient(145deg,#17585a,#0a7773);box-shadow:0 15rpx 38rpx rgba(8,94,91,.2);margin-bottom:24rpx}.no{font-family:monospace;color:#bde1df;font-size:22rpx}.status{padding:7rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.13);font-size:20rpx}.place{font-size:37rpx;font-weight:750;margin-top:25rpx}.meta{color:#c5e2e0;font-size:23rpx;margin-top:9rpx}.devices{display:flex;flex-wrap:wrap;gap:9rpx;margin-top:23rpx}.devices text{padding:9rpx 13rpx;border-radius:12rpx;background:rgba(255,255,255,.1);font-size:22rpx}
.form-card{border:1rpx solid #d7e9e7}.return-tip{padding:18rpx;margin-bottom:20rpx;border-radius:16rpx;background:#fff0f0;color:#b44949;font-size:22rpx;line-height:1.6}.field{margin-bottom:22rpx}.field>text{display:block;color:#637979;margin-bottom:10rpx;font-size:23rpx}.field textarea{width:100%;height:150rpx;padding:18rpx;border-radius:16rpx;background:#f4f7f7;line-height:1.55}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.summary-grid view{padding:16rpx;border-radius:14rpx;background:#f3f8f7}.summary-grid text,.summary-grid strong{display:block}.summary-grid text{font-size:20rpx;color:#7d8e8d}.summary-grid strong{margin-top:5rpx;color:#244746}.impact{margin-top:18rpx;line-height:1.6}.readiness{margin-top:18rpx;padding:17rpx;border-radius:14rpx;background:#fff7e9;color:#8a642d}.readiness strong,.readiness text{display:block}.readiness text{margin-top:7rpx;font-size:22rpx}.action>text{display:block;margin-top:12rpx;color:#7d8e8d;font-size:22rpx}.action-note{margin-top:16rpx;line-height:1.6}.action button{margin-top:20rpx}.timeline-item{display:flex;gap:18rpx;padding:13rpx 0}.timeline-item>text{width:14rpx;height:14rpx;margin-top:9rpx;border-radius:50%;background:#087f7a}.timeline-item view{flex:1;border-bottom:1rpx solid #edf2f1;padding-bottom:14rpx}.timeline-item strong,.timeline-item small{display:block}.timeline-item small{margin-top:6rpx;color:#829291;font-size:20rpx}
.statement{padding-bottom:22rpx}.statement strong{font-size:29rpx}.employee{margin-left:13rpx;color:#8b9999;font-size:21rpx}.state{padding:7rpx 13rpx;border-radius:999rpx;background:#fff2de;color:#a87325;font-size:20rpx}.state.APPROVED{background:#e8f6ef;color:#29825d}.state.RETURNED{background:#fff0f0;color:#bd4d4d}.answer{margin-top:22rpx}.answer>text{display:block;color:#839292;font-size:22rpx;margin-bottom:8rpx}.answer>view{line-height:1.7;color:#2d4545}.waiting{margin-top:22rpx;padding:20rpx;text-align:center;border-radius:15rpx;background:#f5f7f7;color:#8a9999}.review-comment{margin-top:19rpx;padding:17rpx;border-radius:14rpx;background:#fff7e9;color:#8a642d;font-size:23rpx}.review-actions{display:flex;gap:14rpx;margin-top:22rpx}.review-actions button{flex:1;margin:0;border-radius:17rpx}.return{background:#fff0f0;color:#c14d4d}.approve{background:#087f7a;color:#fff}.note strong,.note text{display:block}.note text{color:#92a0a0;font-size:21rpx;margin:4rpx 0 16rpx}.note view{line-height:1.7}
