<view class="page" wx:if="{{incident}}">
  <view class="hero"><view class="row"><text class="no">{{incident.incidentNo}}</text><text class="status">{{incident.statusText}}</text></view><view class="place">{{incident.lineName}} · {{incident.stationName}}</view><view class="meta">{{incident.occurredAtText}} · {{incident.shiftCode === 'NIGHT' ? '夜班' : '白班'}}</view><view class="devices"><text wx:for="{{incident.devices}}" wx:key="id">{{item.name}}（{{item.code}}）</text></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{draftNotice}}" class="card">{{draftNotice}}<button bindtap="discardDraft">放弃草稿</button></view>
  <view wx:if="{{dossier}}" class="card dossier-summary"><view class="title">异常档案</view><view class="summary-grid"><view><text>严重程度</text><strong>{{dossier.severityText}}</strong></view><view><text>异常分类</text><strong>{{dossier.categoryCodeText}}</strong></view><view><text>影响等级</text><strong>{{dossier.impactLevelText}}</strong></view><view><text>停机时间</text><strong>{{dossier.downtimeMinutes}} 分钟</strong></view></view><view wx:if="{{dossier.impactDescription}}" class="impact">{{dossier.impactDescription}}</view><view wx:if="{{!dossier.archiveReadiness.ready}}" class="readiness"><strong>归档前还需完成</strong><text wx:for="{{dossier.archiveReadiness.missingItems}}" wx:key="*this">· {{item}}</text></view></view>
  <view wx:if="{{canSubmit}}" class="card form-card"><view class="title">提交我的异常说明</view><view wx:if="{{own.status === 'RETURNED'}}" class="return-tip">审核退回：{{own.reviewComment}}<br/>请在 {{own.resubmitDueAtText}} 前重新提交</view>
    <view class="field"><text>异常现象 *</text><textarea disabled="{{saving}}" value="{{phenomenon}}" maxlength="2000" placeholder="客观描述设备发生了什么异常" bindinput="inputPhenomenon"/></view>
    <view class="field"><text>处理方法 *</text><textarea disabled="{{saving}}" value="{{handlingMethod}}" maxlength="2000" placeholder="填写现场处理步骤和结果" bindinput="inputHandling"/></view>
    <view class="field"><text>问题根因 *</text><textarea disabled="{{saving}}" value="{{rootCause}}" maxlength="2000" placeholder="填写分析确认的问题根因" bindinput="inputRoot"/></view>
    <view class="field"><text>长期对策（选填）</text><textarea disabled="{{saving}}" value="{{longTermAction}}" maxlength="2000" placeholder="填写防止再次发生的长期措施" bindinput="inputAction"/></view>
    <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">提交主管审核</button>
  </view>
  <block wx:if="{{dossier.investigation}}"><view class="section-title"><text>调查结论</text></view><view class="card investigation"><view class="answer"><text>直接原因</text><view>{{dossier.investigation.directCause}}</view></view><view class="answer"><text>根本原因 · {{dossier.investigation.rootCauseCategoryText}}</text><view>{{dossier.investigation.rootCause}}</view></view><view class="answer"><text>调查结论</text><view>{{dossier.investigation.conclusion}}</view></view></view></block>
  <block wx:if="{{dossier.actions.length}}"><view class="section-title"><text>整改与验收</text></view><view class="card action" wx:for="{{dossier.actions}}" wx:key="id"><view class="row"><strong>{{item.content}}</strong><text class="state">{{item.statusText}}</text></view><text>责任人：{{item.ownerName}} · 截止 {{item.dueAtText}}</text><view wx:if="{{item.completionNote}}" class="action-note">完成说明：{{item.completionNote}}</view><view wx:if="{{item.acceptanceComment}}" class="review-comment">验收意见：{{item.acceptanceComment}}</view><button wx:if="{{item.ownerId === meId && (item.status === 'PENDING' || item.status === 'IN_PROGRESS' || item.status === 'RETURNED')}}" class="primary" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="completeAction">提交整改完成</button></view></block>
  <block wx:if="{{dossier.events.length}}"><view class="section-title"><text>档案时间线</text></view><view class="card timeline"><view wx:for="{{dossier.events}}" wx:key="id" class="timeline-item"><text></text><view><strong>{{item.eventTypeText}}</strong><small>{{item.actorName}} · {{item.createdAtText}}</small></view></view></view></block>
  <view class="section-title"><text>责任人说明</text></view>
  <view wx:for="{{incident.statements}}" wx:key="id" class="card statement"><view class="row"><view><strong>{{item.responsibleName}}</strong><text class="employee">{{item.employeeNo}}</text></view><text class="state {{item.status}}">{{item.statusText}}</text></view>
    <block wx:if="{{item.phenomenon}}"><view class="answer"><text>异常现象</text><view>{{item.phenomenon}}</view></view><view class="answer"><text>处理方法</text><view>{{item.handlingMethod}}</view></view><view class="answer"><text>问题根因</text><view>{{item.rootCause}}</view></view><view wx:if="{{item.longTermAction}}" class="answer"><text>长期对策</text><view>{{item.longTermAction}}</view></view></block><view wx:else class="waiting">尚未提交 · 截止 {{item.dueAtText}}</view>
    <view wx:if="{{supervisor && item.status === 'OVERDUE'}}" class="review-comment">说明已逾期，责任人提交后才能审核。</view><view wx:if="{{item.reviewComment}}" class="review-comment">审核意见：{{item.reviewComment}}</view><view wx:if="{{supervisor && item.status === 'SUBMITTED'}}" class="review-actions"><button class="return" disabled="{{reviewing}}" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="returnStatement">退回修改</button><button class="approve" disabled="{{reviewing}}" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="approve">审核通过</button></view>
  </view>
  <block wx:if="{{incident.notes.length}}"><view class="section-title"><text>追加说明</text></view><view class="card note" wx:for="{{incident.notes}}" wx:key="id"><strong>{{item.actorName}}</strong><text>{{item.createdAtText}}</text><view>{{item.content}}</view></view></block>
</view><view wx:else class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:else class="card empty">正在加载异常详情...</view></view>
