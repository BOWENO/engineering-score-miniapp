.profile-page{padding-top:34rpx}.profile-hero{display:flex;align-items:center;gap:20rpx;padding:30rpx;margin-bottom:24rpx;color:#fff;border-radius:29rpx;background:linear-gradient(145deg,#0a8780,#155b5b)}.avatar{width:92rpx;height:92rpx;line-height:92rpx;text-align:center;border-radius:28rpx;background:rgba(255,255,255,.16);font-size:38rpx;font-weight:750}.profile-hero strong,.profile-hero text{display:block}.profile-hero strong{font-size:36rpx}.profile-hero text{color:#c7e3e1;font-size:23rpx;margin-top:7rpx}.password-card{border:2rpx solid #f2d9a8}.warning-title{font-size:31rpx;font-weight:700;color:#9e6a1d}.warning-text{line-height:1.6;color:#9b7a4b;font-size:23rpx;margin:10rpx 0 22rpx}.password-card input{height:80rpx;padding:0 18rpx;margin-bottom:14rpx;background:#f5f7f7;border-radius:15rpx}.menu{padding-top:4rpx;padding-bottom:4rpx}.menu>view{display:flex;align-items:center;justify-content:space-between;min-height:90rpx;border-bottom:1rpx solid #edf1f1}.menu>view:last-child{border:0}.menu>view>view{display:flex;flex-direction:column}.menu small{color:#8b9a9a;font-size:20rpx;margin-top:5rpx}.menu .bound{color:#26845e}.admin-tip{padding:18rpx 22rpx;border-radius:17rpx;background:#eaf5f4;color:#427673;font-size:22rpx}.logout{margin-top:24rpx;border-radius:20rpx;background:#fff0f0;color:#c34f4f}
.login-brand{display:flex;flex-direction:column;align-items:center;padding:42rpx 0 35rpx}.brand-mark{width:105rpx;height:105rpx;line-height:105rpx;text-align:center;border-radius:34rpx;background:linear-gradient(145deg,#0b948c,#086b67);color:#fff;font-size:45rpx;font-weight:800;box-shadow:0 16rpx 35rpx rgba(8,127,122,.23)}.login-brand strong{font-size:36rpx;margin-top:22rpx}.login-brand>text{color:#839494;font-size:22rpx;margin-top:9rpx}.login-card{padding:32rpx}.field{margin-bottom:21rpx}.field text{display:block;color:#627777;font-size:23rpx;margin-bottom:9rpx}.field input{height:82rpx;padding:0 20rpx;border-radius:16rpx;background:#f3f7f7}.divider{display:flex;align-items:center;justify-content:center;color:#98a5a5;font-size:21rpx;margin:24rpx 0}.divider:before,.divider:after{content:'';height:1rpx;flex:1;background:#e7eded;margin:0 15rpx}.wechat{border-radius:20rpx;background:#eaf7ef;color:#218459}.login-tip{text-align:center;color:#93a0a0;font-size:20rpx;line-height:1.6;margin-top:19rpx}
.subscription-card{margin-top:18rpx;padding:24rpx;border-radius:22rpx;background:linear-gradient(135deg,#e8f7f0,#e6f6f5);color:#315f59}.subscription-card strong,.subscription-card>view>text{display:block}.subscription-card>view>text{margin-top:7rpx;color:#75958c;font-size:21rpx;line-height:1.5}.subscription-card .subscription-state{color:#157858;font-size:24rpx;font-weight:700}.subscribe-button{margin-top:18rpx;border-radius:18rpx;background:#157f68;color:#fff}.subscription-hint{display:block;margin-top:15rpx;color:#a06a24;font-size:22rpx}
