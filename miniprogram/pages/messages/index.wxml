<view class="page"><view class="summary"><button data-filter="all" bindtap="changeFilter" disabled="{{filter==='all'}}">全部消息</button><button data-filter="unread" bindtap="changeFilter" disabled="{{filter==='unread'}}">未读消息</button></view><view class="summary"><view><strong>{{unread}}</strong><text>未读消息</text></view><view><strong>{{awaiting}}</strong><text>待确认事项</text></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading && !items.length}}" class="card empty">消息加载中...</view><view wx:elif="{{!items.length}}" class="card empty">暂无消息</view>
  <view wx:for="{{items}}" wx:key="id" class="message {{!item.readAt ? 'unread' : ''}} {{item.requiresAcknowledgement && !item.acknowledgedAt ? 'required' : ''}}" data-index="{{index}}" bindtap="open"><view class="message-dot"></view><view class="content"><view class="message-head"><strong>{{item.title}}</strong><text wx:if="{{item.requiresAcknowledgement && !item.acknowledgedAt}}">待确认</text></view><view class="body">{{item.content}}</view><view class="time">{{item.createdAt}}</view></view><text class="arrow">›</text></view>
<button wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="more">加载更早消息</button><button wx:if="{{error}}" bindtap="onPullDownRefresh">重新加载</button></view>