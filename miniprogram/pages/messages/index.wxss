.summary{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:24rpx}.summary view{padding:25rpx;text-align:center;border-radius:23rpx;background:#fff;box-shadow:0 8rpx 25rpx rgba(22,74,72,.05)}.summary strong,.summary text{display:block}.summary strong{font-size:42rpx;color:#087f7a}.summary text{font-size:22rpx;color:#819191;margin-top:3rpx}.message{position:relative;display:flex;align-items:flex-start;gap:17rpx;padding:25rpx 45rpx 25rpx 22rpx;margin-bottom:12rpx;border-radius:22rpx;background:#fff;box-shadow:0 6rpx 22rpx rgba(22,74,72,.04)}.message.unread{background:#f8fffe}.message.required{border-left:6rpx solid #e4584d}.message-dot{width:13rpx;height:13rpx;margin-top:12rpx;border-radius:50%;background:transparent}.unread .message-dot{background:#0a8d86}.content{flex:1}.message-head{display:flex;align-items:center;gap:12rpx}.message-head strong{font-size:28rpx}.message-head text{padding:4rpx 10rpx;border-radius:10rpx;background:#fff0ee;color:#ca5148;font-size:19rpx}.body{color:#5d7171;line-height:1.6;margin-top:9rpx;font-size:24rpx}.time{color:#9ba8a8;font-size:20rpx;margin-top:9rpx}.arrow{position:absolute;right:19rpx;top:50%;transform:translateY(-50%);color:#aeb9b9;font-size:35rpx}
