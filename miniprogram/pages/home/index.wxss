.home-page { padding-top: 34rpx; }
.publicity-card{margin-bottom:28rpx;padding:30rpx 28rpx 14rpx;border:1rpx solid #efdcd1;border-radius:30rpx;background:linear-gradient(145deg,#fff6ee 0%,#fff 48%);box-shadow:0 12rpx 34rpx rgba(131,70,37,.07);overflow:hidden}
.publicity-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.publicity-eyebrow{display:flex;align-items:center;gap:9rpx;font-size:20rpx;letter-spacing:3rpx;color:#995b3a;font-weight:600}.publicity-dot{width:10rpx;height:10rpx;background:#bf653d;border-radius:50%}.publicity-title{display:block;margin-top:9rpx;color:#3b2921;font-weight:750;font-size:37rpx;letter-spacing:1rpx}.publicity-date{display:flex;gap:12rpx;align-items:center;padding:12rpx 14rpx;background:rgba(255,255,255,.8);border:1rpx solid #ead9ca;border-radius:14rpx;color:#75533c;font-size:22rpx;white-space:nowrap}.publicity-caption{margin-top:12rpx;font-size:22rpx;color:#907a6c;line-height:1.6}
.publicity-summary{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:22rpx 0;border-top:1rpx solid #f0e6de;border-bottom:1rpx solid #f0e6de}.publicity-summary>view{display:flex;align-items:baseline;gap:9rpx;color:#87776c;font-size:21rpx}.publicity-number{font-size:38rpx;font-weight:750;color:#493b32;font-variant-numeric:tabular-nums}.publicity-total .publicity-number{color:#b24838}.publicity-item{padding:24rpx 0;border-bottom:1rpx solid #f2ebe5}.publicity-item-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.publicity-person{display:flex;align-items:center;gap:12rpx;min-width:0;flex-wrap:wrap}.publicity-name{font-size:28rpx;font-weight:650;color:#3d3833;word-break:break-all}.publicity-role{font-size:19rpx;background:#f3f2ef;color:#787269;padding:5rpx 10rpx;border-radius:8rpx;white-space:nowrap}.publicity-score{color:#b24838;font-size:33rpx;font-weight:750;white-space:nowrap}.publicity-score text{font-size:20rpx;margin-left:5rpx;font-weight:400}.publicity-description{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:25rpx;line-height:1.65;color:#5e5852;margin:12rpx 0;word-break:break-all}.publicity-meta{display:flex;justify-content:space-between;gap:12rpx;color:#9b8d80;font-size:20rpx;flex-wrap:wrap}.publicity-appeal{color:#a36532}.publicity-foot{display:flex;align-items:center;justify-content:space-between;gap:8rpx;color:#a29589;font-size:19rpx;min-height:65rpx}.publicity-foot button{margin:0;padding:12rpx 6rpx;line-height:1.4;min-height:0;background:transparent;font-size:21rpx;color:#9a5e3c}.publicity-foot button::after,.publicity-more::after{border:0}.publicity-more{margin:18rpx 0 4rpx;background:#faf5f0;border-radius:14rpx;color:#8a6349;font-size:23rpx;line-height:68rpx}.publicity-empty{display:flex;align-items:center;gap:18rpx;padding:32rpx 0;color:#6c6257;font-size:25rpx}.publicity-empty-mark{width:58rpx;height:58rpx;background:#f5f1eb;border-radius:18rpx;text-align:center;line-height:58rpx;color:#ad9986}.publicity-empty-note{display:block;margin-top:8rpx;font-size:21rpx;color:#a39789}.publicity-state{padding:30rpx 0;text-align:center;color:#837260;font-size:25rpx}.publicity-state text{display:block}.publicity-state button{margin-top:16rpx;font-size:24rpx;background:#f7eadd;color:#875637}.publicity-error{font-size:21rpx;margin-top:12rpx;word-break:break-all}
.top-row { display:flex; justify-content:space-between; align-items:center; margin: 6rpx 4rpx 30rpx; }
.greeting { display:block; font-size:38rpx; font-weight:750; letter-spacing:-1rpx; }
.identity { color:#788989; font-size:24rpx; margin-top:8rpx; }
.message-button { position:relative; background:#fff; padding:14rpx 22rpx; border-radius:999rpx; color:#365252; box-shadow:0 6rpx 20rpx rgba(22,74,72,.08); }
.message-dot { position:absolute; top:-12rpx; right:-8rpx; min-width:32rpx; height:32rpx; text-align:center; line-height:32rpx; padding:0 4rpx; border-radius:20rpx; color:#fff; background:#e35050; font-size:19rpx; }
.notification-banner{display:flex;align-items:center;gap:18rpx;margin-bottom:22rpx;padding:21rpx 23rpx;border:1rpx solid #cde8dd;border-radius:23rpx;background:#edf9f4}.notification-banner>view{flex:1}.notification-banner strong,.notification-banner text{display:block}.notification-banner strong{color:#176c59;font-size:27rpx}.notification-banner text{margin-top:5rpx;color:#6b8d84;font-size:21rpx}.notification-banner button{margin:0;padding:0 20rpx;min-height:60rpx;line-height:60rpx;border-radius:16rpx;background:#167d67;color:#fff;font-size:22rpx}
.score-hero { padding:32rpx; color:#fff; border-radius:32rpx; background:linear-gradient(145deg,#0b958d,#056a67); box-shadow:0 22rpx 48rpx rgba(8,127,122,.26); }
.hero-head,.hero-main { display:flex; justify-content:space-between; align-items:center; }
.hero-head { color:#ccebe8; font-size:25rpx; }.hero-link { font-size:23rpx; }
.hero-main { margin:25rpx 0 28rpx; }.average { font-size:72rpx; line-height:1; font-weight:780; }.unit { color:#d7efed; font-size:24rpx; }
.rank { text-align:right; display:flex; flex-direction:column; color:#c7e9e7; font-size:23rpx; }.rank strong { color:#fff; font-size:42rpx; margin-top:2rpx; }
.score-parts { display:flex; justify-content:space-between; color:#d7efed; font-size:22rpx; padding-top:22rpx; border-top:1rpx solid rgba(255,255,255,.18); }
.grade { margin-top:18rpx; padding:12rpx 16rpx; border-radius:14rpx; background:rgba(255,255,255,.12); font-size:22rpx; }
.management-hero { color:#fff; border-radius:32rpx; padding:32rpx; background:linear-gradient(145deg,#173b4b,#13585a); box-shadow:0 20rpx 45rpx rgba(16,58,66,.2); }
.eyebrow { display:block; color:#9fd0ce; font-size:23rpx; }.management-title { display:block; margin-top:8rpx; font-size:38rpx; font-weight:750; }
.pending-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12rpx; margin-top:30rpx; }.pending-grid view { display:flex; flex-direction:column; padding:18rpx 8rpx; text-align:center; border-radius:20rpx; background:rgba(255,255,255,.08); }.pending-grid strong { font-size:37rpx; }.pending-grid text { color:#bcd5d4; font-size:20rpx; margin-top:4rpx; }.pending-grid .warn strong { color:#ffb3a5; }
.urgent-card { display:flex; align-items:center; gap:18rpx; margin-top:24rpx; padding:22rpx 24rpx; background:#fff0ee; color:#9d3d34; border:1rpx solid #ffd9d3; border-radius:24rpx; }.urgent-icon { width:46rpx;height:46rpx;line-height:46rpx;text-align:center;border-radius:50%;background:#e55b4c;color:#fff;font-weight:700; }.urgent-content { flex:1; }.urgent-content strong,.urgent-content text { display:block; }.urgent-content text { margin-top:5rpx;font-size:23rpx;color:#b7685f; }
.section-link { color:#087f7a;font-size:24rpx;font-weight:400; }
.quick-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx; }.quick-grid>view { display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:25rpx 8rpx;background:#fff;border-radius:24rpx;box-shadow:0 8rpx 26rpx rgba(22,74,72,.05);font-size:24rpx; }.quick-icon { width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:20rpx;font-size:29rpx;font-weight:700; }.teal{color:#087f7a;background:#e3f5f3}.blue{color:#3777b8;background:#eaf3fd}.amber{color:#b7791f;background:#fff4db}.red{color:#c34f4f;background:#ffebeb}.purple{color:#7958ad;background:#f1ebfb}.slate{color:#526c75;background:#edf2f3}
.schedule-card { display:flex;align-items:center;gap:20rpx;padding:22rpx;background:#fff;border-radius:24rpx;margin-bottom:14rpx;box-shadow:0 7rpx 23rpx rgba(22,74,72,.05); }.date-block { width:82rpx;height:82rpx;display:flex;flex-direction:column;justify-content:center;text-align:center;border-radius:20rpx;background:#e8f5f4;color:#087f7a; }.date-block strong { font-size:26rpx; }.date-block text { font-size:20rpx;margin-top:2rpx; }.schedule-info { flex:1;min-width:0; }.schedule-info strong,.schedule-info text { display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }.schedule-info strong{font-size:27rpx}.schedule-info text{font-size:21rpx;color:#889797;margin-top:7rpx}.ack{margin:0;padding:0 18rpx;min-height:56rpx;line-height:56rpx;border-radius:16rpx;background:#e34f4f;color:#fff;font-size:21rpx}.known{color:#2b9b6c;font-size:22rpx}
.hot-list { padding-top:12rpx;padding-bottom:12rpx; }.hot-row { display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #edf2f2; }.hot-row:last-child{border:0}.hot-rank{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:13rpx;background:#eff5f5;color:#668080;font-weight:700}.hot-row view{flex:1}.hot-row strong,.hot-row view text{display:block}.hot-row view text{color:#8a9999;font-size:22rpx;margin-top:3rpx}.hot-count{color:#d46853;font-weight:600}
