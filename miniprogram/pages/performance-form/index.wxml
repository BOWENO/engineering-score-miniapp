<view class="page"><view class="form-hero"><text>{{title}}</text><view>{{type === 'BONUS' ? '申请将在当月依次进入助理工程师和主管审核' : type === 'DEDUCTION' ? '请客观记录违规原因，并给出建议扣分值' : '劝诫只形成管理记录，不影响积分'}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{draftNotice}}" class="card">{{draftNotice}}<button bindtap="discardDraft">放弃草稿</button></view><view class="card form-card"><view wx:if="{{type !== 'BONUS'}}" class="field"><text>责任人 *</text><input disabled="{{saving || submitted}}" placeholder="搜索姓名、工号或班组" value="{{personSearch}}" bindinput="searchPeople"/><view wx:if="{{personSearch && !people.length}}" class="submit-tip">未找到匹配人员，请更换姓名、工号或班组关键词。</view><picker disabled="{{saving || submitted || !people.length}}" range="{{people}}" range-key="label" value="{{targetIndex}}" bindchange="targetChange"><view class="picker">{{people[targetIndex].label || '请选择责任人'}} <text wx:if="{{people[targetIndex]}}">· {{people[targetIndex].teamName}}</text> ›</view></picker></view>
    <view class="double"><view class="field"><text>发生日期 *</text><picker disabled="{{saving || submitted}}" mode="date" value="{{date}}" bindchange="dateChange"><view class="picker">{{date}}</view></picker></view><view class="field"><text>发生时间 *</text><picker disabled="{{saving || submitted}}" mode="time" value="{{time}}" bindchange="timeChange"><view class="picker">{{time}}</view></picker></view></view>
    <view class="field"><text>{{type === 'BONUS' ? '加分事由与证明说明' : type === 'DEDUCTION' ? '违规原因' : '劝诫内容'}} *</text><textarea disabled="{{saving || submitted}}" value="{{description}}" maxlength="2000" placeholder="请填写清晰、可核实的事实描述" bindinput="inputDescription"/></view>
    <block wx:if="{{type === 'DEDUCTION'}}"><view class="field"><text>扣分类型 *</text><picker disabled="{{saving || submitted}}" range="{{deductionKinds}}" range-key="name" value="{{deductionKindIndex}}" bindchange="deductionKindChange"><view class="picker">{{deductionKinds[deductionKindIndex].name}} ›</view></picker></view><view class="field"><text>建议扣分值（整数）*</text><input disabled="{{saving || submitted}}" type="number" value="{{score}}" maxlength="3" placeholder="最终分值由主管确认" bindinput="inputScore"/></view><view class="field"><text>扣分规则{{supervisor ? " *" : "（选填）"}}</text><picker disabled="{{saving || submitted}}" range="{{rules}}" range-key="title" value="{{ruleIndex}}" bindchange="selectRule"><view class="picker">{{ruleIndex >= 0 ? rules[ruleIndex].title : "请选择扣分规则"}} ›</view></picker><text wx:if="{{!rules.length}}">该日期暂无可用规则，请联系管理员配置</text></view></block>
    <view wx:if="{{type !== 'ADMONITION'}}" class="field"><view class="image-head"><text>证明图片（选填，最多9张）</text><text>{{images.length}}/9</text></view><view class="image-grid"><view wx:for="{{images}}" wx:key="path" class="image-item"><image src="{{item.path}}" mode="aspectFill"/><view wx:if="{{item.uploading}}" class="uploading">上传中</view><text data-index="{{index}}" catchtap="removeImage">×</text></view><view wx:if="{{images.length < 9}}" class="image-add" bindtap="chooseImages">＋<text>添加图片</text></view></view></view>
    <button class="primary submit" loading="{{saving}}" disabled="{{saving || submitted || rulesLoading}}" bindtap="submit">{{submitted ? "已提交" : "确认提交"}}</button><view class="submit-tip">提交后系统将完整保留审核和修改记录</view>
  </view></view>
