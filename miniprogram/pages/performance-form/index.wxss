.form-hero{padding:30rpx;margin-bottom:24rpx;border-radius:27rpx;background:linear-gradient(140deg,#0a8580,#17605f);color:#fff}.form-hero>text{display:block;font-size:39rpx;font-weight:750}.form-hero>view{color:#c9e4e2;font-size:23rpx;line-height:1.6;margin-top:10rpx}.form-card{border:1rpx solid #dfebeb}.double{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.field{margin-bottom:25rpx}.field>text,.image-head{display:block;color:#617777;font-size:23rpx;margin-bottom:10rpx}.picker,.field input{height:80rpx;line-height:80rpx;padding:0 20rpx;background:#f4f7f7;border-radius:16rpx}.field textarea{width:100%;height:190rpx;padding:20rpx;background:#f4f7f7;border-radius:16rpx;line-height:1.6}.image-head{display:flex;justify-content:space-between}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.image-item,.image-add{position:relative;height:190rpx;border-radius:17rpx;overflow:hidden}.image-item image{width:100%;height:100%}.image-item>text{position:absolute;right:8rpx;top:8rpx;width:40rpx;height:40rpx;line-height:36rpx;text-align:center;border-radius:50%;background:rgba(0,0,0,.58);color:#fff;font-size:32rpx}.uploading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(0,0,0,.45);font-size:22rpx}.image-add{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6e8484;background:#f0f5f5;border:2rpx dashed #c8d8d7;font-size:42rpx}.image-add text{font-size:21rpx;margin-top:7rpx}.submit{margin-top:10rpx}.submit-tip{text-align:center;color:#91a0a0;font-size:21rpx;margin-top:14rpx}
