.toolbar{display:flex;align-items:center;gap:14rpx;color:#496161;font-size:24rpx}.toolbar picker{padding:13rpx 16rpx;border-radius:14rpx;background:#eef5f5}.add{margin-left:auto;margin-right:0;line-height:58rpx;min-height:58rpx;padding:0 18rpx;border-radius:15rpx;background:#087f7a;color:#fff;font-size:22rpx}
.editor{border:1rpx solid #dceceb}.field{margin-bottom:22rpx}.field>text{display:block;color:#6f8181;font-size:23rpx;margin-bottom:10rpx}.picker{height:78rpx;line-height:78rpx;padding:0 20rpx;background:#f5f8f8;border-radius:16rpx;color:#273d3d}.double{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.publish-row{display:flex;justify-content:space-between;align-items:center;margin:10rpx 0 28rpx}.publish-row strong,.publish-row text{display:block}.publish-row text{color:#849393;font-size:21rpx;margin-top:5rpx}
.assignment{padding:26rpx;margin-bottom:16rpx;background:#fff;border-radius:25rpx;box-shadow:0 8rpx 28rpx rgba(22,74,72,.05);border-left:7rpx solid #90bbb8}.assignment.unread{border-left-color:#e85a51;background:#fffdfc}.assignment-top,.assignment-top>view{display:flex;justify-content:space-between;align-items:center}.assignment-top>view{gap:14rpx}.assignment-top strong{font-size:28rpx}.status{font-size:20rpx;padding:6rpx 12rpx;border-radius:999rpx;background:#eaf5f4;color:#168079}.status.DRAFT{background:#fff3db;color:#aa7423}.status.CANCELLED{background:#f0f1f1;color:#829090}.person{color:#607575;font-size:24rpx}.place{margin-top:18rpx;color:#405959}.place text{color:#9eaeae;margin:0 8rpx}.actions{display:flex;gap:12rpx;justify-content:flex-end;margin-top:20rpx}.actions button{margin:0;min-height:56rpx;line-height:56rpx;padding:0 18rpx;border-radius:15rpx;font-size:21rpx}.ack{background:#e4514a;color:#fff}.cancel{background:#eff4f4;color:#607777}
