.head-row{display:flex;align-items:center;gap:16rpx;margin-bottom:22rpx}.tabs{display:flex;flex:1;background:#e6eeee;border-radius:20rpx;padding:6rpx}.tabs view{flex:1;text-align:center;padding:15rpx 5rpx;color:#718181;font-size:23rpx;border-radius:15rpx}.tabs .active{background:#fff;color:#087f7a;font-weight:650;box-shadow:0 5rpx 16rpx rgba(22,74,72,.08)}.create-button{margin:0;padding:0 18rpx;min-height:66rpx;line-height:66rpx;border-radius:17rpx;background:#087f7a;color:#fff;font-size:22rpx}
.create-form{border:1rpx solid #dceceb}.tip{padding:16rpx 20rpx;margin-bottom:24rpx;border-radius:16rpx;background:#edf7f6;color:#4d7775;font-size:22rpx}.double{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.field{margin-bottom:22rpx}.field>text{display:block;color:#718282;font-size:23rpx;margin-bottom:10rpx}.field picker>view{height:76rpx;line-height:76rpx;padding:0 18rpx;border-radius:15rpx;background:#f4f7f7}.equipment-option{display:flex;align-items:center;gap:12rpx;padding:16rpx;margin-bottom:10rpx;background:#f5f8f8;border-radius:16rpx}.equipment-option view{display:flex;flex-direction:column}.equipment-option text{color:#8a9999;font-size:21rpx;margin-top:3rpx}.mini-empty{padding:25rpx;text-align:center;color:#92a0a0;background:#f6f8f8;border-radius:16rpx;font-size:23rpx}
.incident-card{position:relative;padding:26rpx 48rpx 26rpx 27rpx;margin-bottom:16rpx;background:#fff;border-radius:25rpx;box-shadow:0 8rpx 28rpx rgba(22,74,72,.05)}.card-head{display:flex;justify-content:space-between;align-items:center}.no{font-family:monospace;color:#728484;font-size:22rpx}.state{padding:7rpx 13rpx;border-radius:999rpx;background:#fff0dc;color:#ad7421;font-size:20rpx}.state.ARCHIVED{background:#e7f5ef;color:#26815c}.state.VOID{background:#f0f1f1;color:#7b8888}.state.RETURNED{background:#fff0f0;color:#c44b4b}.place{font-size:30rpx;font-weight:700;margin-top:17rpx}.device{color:#426363;margin-top:9rpx}.meta{display:flex;flex-direction:column;gap:5rpx;margin-top:17rpx;color:#899898;font-size:22rpx}.arrow{position:absolute;right:22rpx;top:50%;transform:translateY(-50%);color:#aab6b6;font-size:40rpx}
