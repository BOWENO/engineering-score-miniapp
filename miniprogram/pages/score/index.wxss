.month-bar{display:flex;align-items:center;justify-content:center;gap:40rpx;margin:4rpx 0 24rpx}.month-bar strong{font-size:32rpx}.month-bar button{margin:0;width:58rpx;height:58rpx;line-height:52rpx;padding:0;border-radius:50%;background:#fff;color:#087f7a;font-size:37rpx}.view-tabs{display:flex;padding:6rpx;margin-bottom:22rpx;border-radius:20rpx;background:#e6eeee}.view-tabs>view{position:relative;flex:1;text-align:center;padding:15rpx 5rpx;border-radius:15rpx;color:#718282;font-size:23rpx}.view-tabs .active{background:#fff;color:#087f7a;font-weight:650}.view-tabs .badge{position:absolute;top:-10rpx;right:4rpx}
.score-card{padding:31rpx;color:#fff;border-radius:30rpx;background:linear-gradient(145deg,#0b9189,#086864);box-shadow:0 18rpx 40rpx rgba(8,127,122,.22)}.score-card .row>text:first-child{color:#c8e7e4;font-size:24rpx}.rank{padding:8rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.12);font-size:22rpx}.average{font-size:76rpx;font-weight:780;margin:20rpx 0}.parts{display:flex;justify-content:space-between;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.18);color:#d4ebe9;font-size:21rpx}.parts .plus{color:#adf0cf}.parts .minus{color:#ffc5bc}.final-grade{margin-top:18rpx;padding:12rpx 16rpx;background:rgba(255,255,255,.12);border-radius:13rpx;font-size:22rpx}.bonus-button{margin-top:20rpx}
.case-card{position:relative;padding:25rpx;margin-bottom:15rpx;background:#fff;border-radius:23rpx;box-shadow:0 7rpx 24rpx rgba(22,74,72,.05)}.case-type{color:#087f7a;font-weight:650}.case-status{padding:6rpx 12rpx;border-radius:999rpx;background:#edf5f4;color:#5a7775;font-size:20rpx}.case-status.RETURNED,.case-status.REJECTED{background:#fff0f0;color:#c04e4e}.case-status.EFFECTIVE{background:#e9f7ef;color:#29805b}.description{line-height:1.65;margin-top:16rpx;color:#385050}.case-meta{margin-top:13rpx;color:#8d9b9b;font-size:21rpx}.case-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:15rpx}.case-actions button{margin:0;min-height:55rpx;line-height:55rpx;padding:0 16rpx;border-radius:14rpx;font-size:21rpx;background:#eaf5f4;color:#087f7a}.case-actions .appeal{background:#fff0f0;color:#bd4b4b}
.grade-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:6rpx;margin-bottom:24rpx}.grade-strip view{display:flex;flex-direction:column;text-align:center;padding:15rpx 2rpx;background:#fff;border-radius:14rpx}.grade-strip strong{color:#087f7a}.grade-strip text{font-size:18rpx;color:#8b9a9a;margin-top:3rpx}.person-row{display:flex;align-items:center;gap:15rpx;padding:20rpx;margin-bottom:10rpx;background:#fff;border-radius:20rpx}.person-rank{width:42rpx;height:42rpx;line-height:42rpx;text-align:center;border-radius:13rpx;background:#e9f4f3;color:#087f7a;font-weight:700}.person-info{flex:1}.person-info strong,.person-info text,.person-score strong,.person-score text{display:block}.person-info text,.person-score text{color:#8c9999;font-size:20rpx;margin-top:4rpx}.person-score{text-align:right}.person-score strong{font-size:28rpx}.grade{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:15rpx;background:#173f47;color:#fff;font-weight:700}
.management-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.management-actions button{background:#e5f4f2;color:#087f7a;border-radius:18rpx}.target{display:block;margin-top:17rpx}.review-link{position:absolute;right:22rpx;bottom:20rpx;color:#087f7a;font-size:21rpx}.review-panel{position:fixed;inset:0;z-index:20}.panel-mask{position:absolute;inset:0;background:rgba(12,34,34,.48)}.panel{position:absolute;left:0;right:0;bottom:0;padding:32rpx 28rpx 50rpx;border-radius:32rpx 32rpx 0 0;background:#fff}.close{font-size:42rpx;color:#809090}.panel-desc{padding:18rpx;margin:20rpx 0;background:#f3f7f7;border-radius:16rpx;line-height:1.6}.field{margin-bottom:16rpx}.field>text{display:block;color:#718282;font-size:22rpx;margin-bottom:8rpx}.field input,.field textarea{width:100%;padding:16rpx 18rpx;background:#f3f6f6;border-radius:14rpx}.field textarea{height:110rpx}.decision-buttons,.vote-buttons{display:flex;gap:10rpx}.decision-buttons button,.vote-buttons button{flex:1;margin:0;border-radius:16rpx;background:#fff0f0;color:#bb4a4a}.decision-buttons button:nth-child(2){background:#fff5df;color:#a36c20}.decision-buttons .approve,.vote-buttons .approve{background:#087f7a;color:#fff}.appeal-card>.description{margin-bottom:10rpx}.vote-buttons{margin-top:18rpx}
.d-nominate{margin:0;padding:0 10rpx;min-height:48rpx;line-height:48rpx;border-radius:12rpx;background:#fff0f0;color:#bd4a4a;font-size:19rpx}.d-card{border-left:6rpx solid #d4574c}.settle-intro strong,.settle-intro text{display:block}.settle-intro text{margin:10rpx 0 22rpx;color:#758787;line-height:1.6;font-size:23rpx}.settlement-card>.row>view:first-child strong,.settlement-card>.row>view:first-child text{display:block}.settlement-card>.row>view:first-child text{color:#879797;font-size:21rpx;margin-top:4rpx}.confirm-count{text-align:right;color:#087f7a;font-size:30rpx;font-weight:700}.confirm-count text{display:block;color:#899999;font-size:18rpx;font-weight:400}.boundary-tip{padding:15rpx;margin:17rpx 0;border-radius:14rpx;background:#fff4df;color:#9c6c27;font-size:22rpx}.candidate{display:flex;align-items:center;gap:13rpx;padding:15rpx 0;border-top:1rpx solid #edf1f1}.candidate>text:first-child{width:35rpx;color:#087f7a;font-weight:700}.candidate>view:nth-child(2){flex:1}.candidate view strong,.candidate view small{display:block}.candidate small{color:#8b9999;font-size:19rpx;margin-top:3rpx}.candidate>view:nth-child(3){text-align:right}.candidate button{margin:0;padding:0 10rpx;min-height:48rpx;line-height:48rpx;border-radius:11rpx;background:#fff3de;color:#98661f;font-size:18rpx}.confirm-button{margin-top:20rpx}
.correction-entry strong,.correction-entry>text{display:block}.correction-entry>text{margin:10rpx 0 18rpx;color:#758787;font-size:22rpx;line-height:1.6}.correction-people{display:flex;flex-wrap:wrap;gap:10rpx}.correction-people button{margin:0;padding:0 15rpx;min-height:54rpx;line-height:54rpx;border-radius:14rpx;background:#e8f5f3;color:#087f7a;font-size:21rpx}.correction-card{border-left:6rpx solid #e5a438}.correction-score{margin-top:14rpx;color:#b87519;font-size:34rpx;font-weight:750}

.highlight{border:3rpx solid #087f7a;background:#edf9f5}
