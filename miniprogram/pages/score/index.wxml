<view class="page"><view wx:if="{{targetNotice}}" class="card">{{targetNotice}}</view><view wx:if="{{targetRecord}}" class="card highlight"><view>{{targetRecord.targetName}} · {{targetRecord.typeText}} · {{targetRecord.statusText}}</view><view>{{targetRecord.description}}</view><view>实际生效分值：{{targetRecord.effectiveScore}}</view></view>
  <view class="caption">{{liveConnected ? "积分变动后自动更新" : "自动更新连接中，暂显示上次数据"}}</view>
  <view class="month-bar"><button bindtap="previousMonth">‹</button><strong>{{period}}</strong><button bindtap="nextMonth">›</button></view>
  <view class="view-tabs" wx:if="{{(scored && (assistant || supervisor || manager)) || supervisor || manager}}"><view wx:if="{{scored}}" class="{{active==='mine'?'active':''}}" data-key="mine" bindtap="switchView">我的积分</view><view wx:if="{{supervisor || manager}}" class="{{active==='overview'?'active':''}}" data-key="overview" bindtap="switchView">人员绩效</view><view wx:if="{{assistant || supervisor || manager}}" class="{{active==='review'?'active':''}}" data-key="review" bindtap="switchView">审核中心<text wx:if="{{pending.length || appeals.length}}" class="badge">{{pending.length+appeals.length}}</text></view><view wx:if="{{supervisor || manager}}" class="{{active==='settlement'?'active':''}}" data-key="settlement" bindtap="switchView">月度封存</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{active==='mine' && personal}}"><view class="score-card"><view class="row"><text>本月平均分</text><text class="rank">排名 {{personal.rank || '--'}}</text></view><view class="average">{{personal.averageScore}}</view><view class="parts"><text>总分 {{personal.total}}</text><text>班次 {{personal.shiftCount}}</text><text>基础 {{personal.base}}</text><text class="plus">+{{personal.bonus}}</text><text class="minus">-{{personal.penalty}}</text></view><view wx:if="{{personal.finalGrade}}" class="final-grade">月度已封存 · 最终等级 {{personal.finalGrade}}</view></view>
    <button class="primary bonus-button" bindtap="goBonus">＋ 申请加分</button><view class="section-title"><text>我的绩效事项</text></view><view wx:if="{{!cases.length}}" class="card empty">本月暂无申请、扣分或劝诫记录</view><view wx:for="{{cases}}" wx:key="id" id="case-{{item.id}}" class="case-card {{highlightId===item.id?'highlight':''}}"><view class="row"><text class="case-type">{{item.typeText}}</text><text class="case-status {{item.status}}">{{item.statusText}}</text></view><view class="description">{{item.description}}</view><view class="case-meta">{{item.occurredAt}}<text wx:if="{{item.effectiveScore !== null && item.effectiveScore !== undefined}}"> · 生效 {{item.effectiveScore}} 分</text></view><view class="case-actions"><button wx:if="{{item.status==='RETURNED' && item.caseType==='BONUS'}}" data-id="{{item.id}}" bindtap="resubmit">修改后重提</button><button wx:if="{{item.status==='EFFECTIVE' && (item.caseType==='BASE_DEDUCTION'||item.caseType==='SPECIAL_DEDUCTION')}}" class="appeal" data-id="{{item.id}}" bindtap="appeal">申诉</button></view></view><block wx:if="{{dMine.length}}"><view class="section-title"><text>我的D级认定</text></view><view wx:for="{{dMine}}" wx:key="id" class="case-card d-card"><view class="row"><strong>D级认定</strong><text class="case-status">{{item.status}}</text></view><view class="description">{{item.description}}</view><view class="case-meta">{{item.reasonCode}} · 审批状态已更新</view><view class="case-actions"><button wx:if="{{item.status==='CONFIRMED'}}" class="appeal" data-id="{{item.id}}" bindtap="appealD">在24小时内申诉</button></view></view></block>
  </block>

  <block wx:if="{{active==='overview'}}"><view class="grade-strip"><view wx:for="{{gradeKeys}}" wx:key="*this"><strong>{{item}}</strong><text>{{gradeCounts[item] || 0}}人</text></view></view><view class="section-title"><text>实时绩效与预估等级</text><text class="caption">共 {{people.length}} 人</text></view><view wx:if="{{!people.length}}" class="card empty">本月暂无有效排班积分</view><view wx:for="{{people}}" wx:key="userId" class="person-row"><text class="person-rank">{{item.rank}}</text><view class="person-info"><strong>{{item.name}}</strong><text>{{item.employeeNo}} · {{item.teamName}}</text></view><view class="person-score"><strong>{{item.averageScore}}</strong><text>总分 {{item.total}}</text></view><text class="grade">{{item.previewGrade}}</text><button wx:if="{{supervisor && !item.dGrade}}" class="d-nominate" data-id="{{item.userId}}" bindtap="nominateD">提名D</button></view></block>

  <block wx:if="{{active==='review'}}"><view wx:if="{{supervisor}}" class="management-actions"><button bindtap="goDeduction">发起扣分</button><button bindtap="goAdmonition">记录劝诫</button></view><view class="section-title"><text>待审核绩效事项</text></view><view wx:if="{{!pending.length}}" class="card empty">没有待审核绩效事项</view><view wx:for="{{pending}}" wx:key="id" id="case-{{item.id}}" class="case-card review-card" data-id="{{item.id}}" bindtap="selectReview"><view class="row"><text class="case-type">{{item.typeText}}</text><text class="case-status">{{item.statusText}}</text></view><strong class="target">{{item.targetName}} · {{item.targetTeamName}}</strong><view class="description">{{item.description}}</view><view class="case-meta">{{item.occurredAt}}<text wx:if="{{item.suggestedScore}}"> · 建议 {{item.suggestedScore}} 分</text></view><text class="review-link">查看并处理 ›</text></view>
    <view wx:if="{{selected && !manager}}" class="review-panel"><view class="panel-mask" bindtap="selectReview"></view><view class="panel"><view class="row"><strong>审核 {{selected.targetName}} 的{{selected.typeText}}</strong><text class="close" bindtap="selectReview">×</text></view><view class="panel-desc">{{selected.description}}</view><block wx:if="{{supervisor}}"><view class="field"><text>确认分值 *</text><input type="number" value="{{reviewScore}}" bindinput="inputScore"/></view><view class="field"><text>积分规则 *</text><picker range="{{reviewRules}}" range-key="title" value="{{reviewRuleIndex}}" bindchange="selectRule"><view>{{reviewRuleIndex >= 0 ? reviewRules[reviewRuleIndex].title : "请选择规则"}} ›</view></picker><text wx:if="{{!reviewRules.length}}">暂无可用规则，请联系管理员配置</text></view></block><view class="field"><text>审核意见</text><textarea value="{{reviewComment}}" placeholder="退回或否决时必填" bindinput="inputComment"/></view><view class="decision-buttons"><button data-decision="REJECT" bindtap="decide">否决</button><button data-decision="RETURN" bindtap="decide">退回修改</button><button class="approve" data-decision="APPROVE" bindtap="decide">通过</button></view></view></view>
    <block wx:if="{{appeals.length}}"><view class="section-title"><text>待表决扣分申诉</text></view><view wx:for="{{appeals}}" wx:key="id" class="case-card appeal-card"><strong>{{item.applicantName}}</strong><view class="description">{{item.description}}</view><view class="case-meta">已同意 {{item.approvals}} / 2 · 截止 {{item.dueAt}}</view><view wx:if="{{supervisor}}" class="vote-buttons"><button data-id="{{item.id}}" data-decision="REJECT" bindtap="vote">驳回申诉</button><button class="approve" data-id="{{item.id}}" data-decision="APPROVE" bindtap="vote">同意申诉</button></view></view></block>
  </block>
  <block wx:if="{{active==='settlement'}}"><view wx:if="{{supervisor && !settlements.length}}" class="card settle-intro"><strong>生成 {{period}} 月度预结算</strong><text>未决绩效、申诉或异常会自动延后封存；次月5日起且达到当前审批条件后发布。</text><button class="primary" bindtap="createSettlement">生成预结算</button></view><view wx:if="{{!settlements.length && manager}}" class="card empty">本月尚未生成结算，部长仅可只读查看。</view><view wx:for="{{settlements}}" wx:key="runId" class="card settlement-card"><view class="row"><view><strong>{{item.version}}</strong><text>{{item.status}}</text></view><view class="confirm-count">{{item.status==='PUBLISHED'?'已完成':'进行中'}}<text>审批状态</text></view></view><view wx:if="{{item.manualPending}}" class="boundary-tip">当前仍有等级边界待表决。</view><view wx:for="{{item.candidates}}" wx:for-item="person" wx:key="userId" class="candidate"><text>{{person.rank}}</text><view><strong>{{person.displayName}}</strong><small>{{person.employeeNo}} · {{person.shiftCount}}班</small></view><view><strong>{{person.averageScore}}</strong><small>总分{{person.total}}</small></view><text class="grade">{{person.finalGrade}}</text><button wx:if="{{supervisor && person.manualRequired}}" data-run="{{item.runId}}" data-user="{{person.userId}}" data-grade="{{person.proposedGrade}}" bindtap="voteBoundary">边界表决</button></view><button wx:if="{{supervisor && item.status==='PREVIEW' && !item.manualPending}}" class="primary confirm-button" data-id="{{item.runId}}" bindtap="confirmSettlement">确认本月绩效</button></view><block wx:if="{{dNominations.length}}"><view class="section-title"><text>D级提名确认</text></view><view wx:for="{{dNominations}}" wx:key="id" class="case-card"><view class="row"><strong>{{item.displayName}} · {{item.employeeNo}}</strong><text class="case-status">{{item.status}}</text></view><view class="description">{{item.description}}</view><view class="case-meta">{{item.reasonCode}} · 审批状态已更新</view><view wx:if="{{supervisor && item.status==='PENDING'}}" class="vote-buttons"><button data-id="{{item.id}}" data-decision="REJECT" bindtap="confirmD">否决D级</button><button class="approve" data-id="{{item.id}}" data-decision="APPROVE" bindtap="confirmD">同意D级</button></view></view></block><block wx:if="{{dAppeals.length}}"><view class="section-title"><text>D级申诉联合表决</text></view><view wx:for="{{dAppeals}}" wx:key="id" class="case-card"><strong>{{item.applicantName}}</strong><view class="description">{{item.description}}</view><view class="case-meta">达到当前表决条件后可撤销 · 审批进行中</view><view wx:if="{{supervisor}}" class="vote-buttons"><button data-id="{{item.id}}" data-decision="REJECT" bindtap="voteD">驳回</button><button class="approve" data-id="{{item.id}}" data-decision="APPROVE" bindtap="voteD">同意撤销</button></view></view></block></block>
  <block wx:if="{{active==='settlement'}}">
    <block wx:for="{{settlements}}" wx:for-item="run" wx:key="runId">
      <view wx:if="{{supervisor && run.status==='PUBLISHED'}}" class="card correction-entry">
        <strong>封存后发现积分错误？</strong><text>选择人员发起分值更正，达到当前审批通过条件后，系统会重新生成结算批次。</text>
        <view class="correction-people"><button wx:for="{{run.candidates}}" wx:for-item="person" wx:key="userId" data-run="{{run.runId}}" data-user="{{person.userId}}" data-name="{{person.displayName}}" bindtap="requestCorrection">{{person.displayName}}</button></view>
      </view>
    </block>
    <block wx:if="{{corrections.length}}"><view class="section-title"><text>封存更正表决</text></view><view wx:for="{{corrections}}" wx:key="id" class="case-card correction-card"><view class="row"><strong>{{item.displayName}} · {{item.employeeNo}}</strong><text class="case-status">{{item.statusText}}</text></view><view class="correction-score">{{item.adjustmentScore>0?'+':''}}{{item.adjustmentScore}} 分</view><view class="description">{{item.reason}}</view><view class="case-meta">{{item.requesterName}} 发起 · 已同意 {{item.approvals}} / {{item.requiredApprovals}}</view><view wx:if="{{supervisor && item.status==='PENDING'}}" class="vote-buttons"><button data-id="{{item.id}}" data-decision="REJECT" bindtap="voteCorrection">不同意</button><button class="approve" data-id="{{item.id}}" data-decision="APPROVE" bindtap="voteCorrection">同意更正</button></view></view></block>
  </block>
</view>
